# AI-Sentinel configuration (copy this file to .env or set these in your shell)
# All settings have safe defaults — you only need to change what you want.

# Database path (default: data/sentinel.db)
# SENTINEL_DB=data/sentinel.db

# Dry-run mode: 1 = log what WOULD be blocked, but don't actually block (safe for testing)
# SENTINEL_DRY_RUN=0

# ML toggle: 0 = rules only (baseline comparison), 1 = rules + Isolation Forest
# SENTINEL_USE_ML=1

# API Key for remote API access (/sentinel/api/* and /sentinel/health)
# SENTINEL_API_KEY=secret-token-12345

# Webhook URL for incident notification (Slack, Discord, custom SIEM)
# SENTINEL_WEBHOOK_URL=https://example.com/webhook
